# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects — generated by `expo prebuild`, never committed
/ios
/android
.kotlin/
*.orig.*

# Signing material. Committing an Android upload/release keystore or an iOS
# signing certificate is unrecoverable — the key cannot be rotated without
# breaking every existing install's upgrade path.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local environment values. `.env.example` is the committed template.
.env
.env.*
!.env.example

# Firebase / Google service files contain project identifiers, keep them local
google-services.json
GoogleService-Info.plist

# Service-account credentials. These are true secrets — they bypass every
# access control. They belong to a server and must never be near this app.
*service-account*.json
*serviceAccount*.json
*-adminsdk-*.json

# typescript
*.tsbuildinfo
