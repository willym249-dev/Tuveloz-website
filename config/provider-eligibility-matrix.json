  "provider_pathways": {
    "independent_startup": {
      "description": "Adult owner-operator of a sole proprietorship or other independent business holding its own accepted registration, insurance, tax/payout status, agreements, and service evidence.",
      "registration_holder_must_equal_provider_business": true,
      "performing_person_must_equal_verified_owner_operator": true,
      "direct_payout_allowed": true
    },
    "sponsored_trainee_employee": {
      "description": "Paid trainee employed by a separate approved provider business, not TUVELOZ; that business is provider of record and is responsible for hiring, payroll, training, supervision, coverage, repair documents, warranty, assignment, and payout.",
      "registration_holder_must_equal_sponsoring_provider": true,
      "direct_payout_allowed": false,
      "requires_provider_completion_signoff": true
    },
    "provider_business_employee": {
      "description": "A genuine non-trainee employee of a registered standard or specialty provider business, bound to that business by current personnel, employment, workers' compensation, and service records.",
      "registration_holder_must_equal_provider_business": true,
      "direct_payout_allowed": false,
      "prohibited_provider_levels": ["learning_account", "sponsored_trainee", "provisional_independent"]
    }
  },
