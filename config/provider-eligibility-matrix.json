  "stage_snapshot_fields": {
    "discovery": ["provider_business_id", "relationship_path", "provider_level", "service_code", "jurisdiction", "rules_engine_version", "holds_snapshot"],
    "quote": ["provider_business_id", "provider_business_job_acceptance", "service_code", "jurisdiction", "requested_operations", "quote_version", "conditional_requirement_results", "coverage_evidence_discovery_result", "rules_engine_version", "holds_snapshot"],
    "booking_common": ["provider_business_id", "performing_person_id", "performing_person_identity_result_id", "performing_person_age_result_id", "performing_person_service_eligibility_snapshot_id", "relationship_path", "provider_level", "registration_holder_id", "assigned_by_provider_business_id", "provider_assignment_time", "service_code", "jurisdiction", "scheduled_time", "job_location", "coverage_evidence_ids", "competency_evidence_ids", "job_control_profile", "location_rule_result", "scope_check_result", "agreement_versions", "customer_person_acceptance", "rules_engine_version", "holds_snapshot"],
    "booking_sponsored_only": ["sponsoring_provider_id", "personnel_roster_version", "sponsored_employment_record_id", "workers_comp_evidence_id", "supervisor_id", "supervision_level", "supervisor_assignment_id"],
    "booking_provider_employee_only": ["provider_personnel_roster_version", "provider_employee_record_id", "workers_comp_evidence_id"],
    "booking_independent_only": ["verified_owner_operator_id", "no_employee_attestation_or_workers_comp_evidence_id"],
    "job_start_common": ["eligibility_recheck_time", "performing_person_checkin", "vehicle_and_location_safety_check", "customer_substitution_acceptance_when_changed"],
    "job_start_direct_supervision_only": ["supervisor_physical_checkin", "co_location_result", "ability_to_intervene_attestation", "pre_job_checkpoint"],
    "scope_change": ["new_service_code", "new_scope_check_result", "new_price", "provider_business_approval", "customer_change_authorization", "recalculated_eligibility_snapshot"],
    "completion_common": ["before_after_records", "invoice_and_warranty_record", "test_drive_outcome", "no_test_needed_provider_determination_id_when_applicable", "eligible_tester_id_when_applicable", "tester_eligibility_snapshot_id_when_applicable", "tester_insurance_determination_id_when_applicable", "customer_test_drive_authorization_id_when_applicable", "provider_final_invoice_signoff_id_when_applicable", "customer_specific_written_waiver_id_when_applicable", "incident_and_stop_work_status", "completion_time"],
    "completion_sponsored_only": ["milestone_checkpoints", "supervisor_completion_checkpoint", "provider_completion_signoff"],
    "completion_provider_employee_only": ["provider_completion_signoff_when_required"]
  },
  "provider_business_relationship_rule": "relationship_path == 'independent_startup' ? registration_holder_id == provider_business_id && (no_employee_attestation.current || workers_comp_coverage.current) && (provider_level != 'provisional_independent' || provisional_provider_addendum.current) : relationship_path == 'sponsored_trainee_employee' ? registration_holder_id == sponsoring_provider_id && workers_comp_coverage.current && sponsored_provider_addendum.current : relationship_path == 'provider_business_employee' && registration_holder_id == provider_business_id && provider_level in ['standard_provider', 'specialty_provider'] && workers_comp_coverage.current && provider_personnel_addendum.current",
  "performing_person_binding_rule": "performing_person_identity_result.valid && performing_person_age_result.verified_18_plus && performing_person_service_eligibility_snapshot.matches(performing_person_id, provider_business_id_or_sponsoring_provider_id, service_code, job_jurisdiction, scheduled_date) && (relationship_path == 'independent_startup' ? performing_person_id == verified_owner_operator_id : relationship_path == 'sponsored_trainee_employee' ? performing_person_id in sponsored_personnel_roster && sponsored_employment_attestation.matches(performing_person_id, sponsoring_provider_id, scheduled_date) && competency_evidence.matches(performing_person_id, sponsoring_provider_id, service_code, job_jurisdiction, scheduled_date) : relationship_path == 'provider_business_employee' && performing_person_id in provider_personnel_roster && provider_employee_record.matches(performing_person_id, provider_business_id, scheduled_date))",
  "provider_assignment_rule": "relationship_path == 'independent_startup' ? assigned_by_provider_business_id == provider_business_id : relationship_path == 'sponsored_trainee_employee' ? assigned_by_provider_business_id == sponsoring_provider_id && trainee_independent_bid == false && direct_trainee_payout == false : assigned_by_provider_business_id == provider_business_id",
  "insurance_discovery_rule": "service_coverage_requirements = service_requirements.where(is_coverage_evidence); service_coverage_requirements.empty || all(service_coverage_requirements.current && matches(provider_business_id, service_code, jurisdiction))",
  "insurance_booking_rule": "insurance_discovery_rule_passes && (service_coverage_requirements.empty || all(service_coverage_requirements.matches(job_location_type, vehicle_use, scheduled_date)))",
  "supervision_booking_rule": "relationship_path != 'sponsored_trainee_employee' || (service.supervision_by_pathway[relationship_path] == supervision_level && supervisor_assignment.valid_for(service_code, performing_person_id, scheduled_time))",
  "direct_supervision_start_rule": "supervision_level != 'direct_supervision' || (supervisor_physical_checkin.current && supervisor_id == supervisor_assignment.supervisor_id && supervisor_checkin.location == job_location && performing_person_checkin.location == job_location && ability_to_intervene_attestation.accepted && pre_job_checkpoint.accepted)",
  "supervision_completion_rule": "relationship_path != 'sponsored_trainee_employee' || (all(required_milestone_checkpoints.timestamped_and_signed) && supervisor_completion_checkpoint.accepted && provider_completion_signoff.accepted)",
  "scope_definition_rule": "requested_operations subset_of service.allowed_scope_when_present && requested_operations disjoint_from service.prohibited_scope && (!service.activation_requires_mandatory_compliance_defined_nonempty_allowed_scope || service.allowed_scope.count > 0)",
  "location_rule": "service.location_rule.passes(job_location, vehicle_state, traffic_conditions, property_permission, safety_check)",
  "conditional_requirements_rule": "all(applicable(service.conditional_requirements, job_context).accepted_and_valid_through(service_date))",
  "configuration_requirements_rule": "all(coalesce(service.path_requirements[relationship_path], service.requirements).where(evidence_types[requirement_id].requires_expiration not_in ['job_scoped', 'person_service_scoped']).accepted_and_valid_through(service_date))",
  "job_scoped_requirements_rule": "all(coalesce(service.path_requirements[relationship_path], service.requirements).where(evidence_types[requirement_id].requires_expiration in ['job_scoped', 'person_service_scoped']).satisfied_by_current_booking_person_and_records)",
  "customer_assignment_rule": "customer_disclosure.accepted_for(provider_business_id, performing_person_id, service_code, supervision_level) && (performing_person_unchanged || customer_substitution_acceptance.accepted_before_work_start)",
  "test_drive_completion_rule": "!job_control_profiles[service.job_control_profile].test_drive_completion_record_required || (test_drive_outcome == 'not_needed_provider_signed_determination' && no_test_needed_provider_determination.signed_by_eligible_registrant_designee && no_test_needed_provider_determination.matches(job_id, service_code)) || (test_drive_outcome == 'eligible_insured_tester_and_provider_signoff' && (job_control_profiles[service.job_control_profile].test_drive_allowed_for_entry_person != false || eligible_tester_id != performing_person_id) && tester_eligibility_snapshot.valid_for(test_driver, vehicle, service_code, test_time) && tester_insurance_determination.covers(test_driver, vehicle, location, service_code, test_time) && customer_test_drive_authorization.matches(job_id, vehicle_id, test_driver) && provider_final_invoice_signoff.signed_by_eligible_registrant_designee) || (test_drive_outcome == 'customer_specific_written_waiver' && customer_specific_written_waiver.signed_by_customer && customer_specific_written_waiver.matches(job_id, vehicle_id, test_drive_requirement) && customer_specific_written_waiver.signed_before_completion)",
  "generic_code_guard_rule": "provider_level in ['learning_account', 'sponsored_trainee', 'provisional_independent'] ? service.provisional_alias_guard == null : true",
  "base_service_rule": "account_active && pathway_level_compatibility[relationship_path].contains(provider_level) && service.launch_state == 'enabled' && service.allowed_pathways.contains(relationship_path) && service.allowed_provider_levels.contains(provider_level) && provider_levels[provider_level].allowed_service_codes.contains(service_code) && service.jurisdictions.contains(job_jurisdiction) && provider_business_relationship_rule_passes && generic_code_guard_rule_passes && all(baseline_requirements.valid_through(service_date)) && configuration_requirements_rule_passes && current_provider_agreement_accepted && applicable_pathway_addendum_accepted && payment_capabilities_ready && !holds.any",
  "stage_rules": {
    "discovery": "base_service_rule_passes && insurance_discovery_rule_passes",
    "quote": "stage_rules.discovery_passes && provider_business_job_acceptance.accepted && scope_definition_rule_passes && conditional_requirements_rule_passes",
    "booking": "stage_rules.quote_passes && performing_person_binding_rule_passes && provider_assignment_rule_passes && job_scoped_requirements_rule_passes && supervision_booking_rule_passes && location_rule_passes && insurance_booking_rule_passes && customer_assignment_rule_passes",
    "job_start": "stage_rules.booking_rechecked && direct_supervision_start_rule_passes && performing_person_checkin.current && vehicle_and_location_safety_check.passes",
    "scope_change": "stage_rules.job_start_passes && new_service_code != null && recalculate(stage_rules.quote, new_service_code, new_scope, new_price).passes && recalculate(stage_rules.booking, new_service_code, existing_performing_person, existing_supervisor, job_location, scheduled_time).passes && recalculate(stage_rules.job_start, new_service_code, existing_checkins, new_pre_job_checkpoint).passes && provider_business_change_approval.accepted && customer_updated_service_and_person_disclosure.accepted && customer_change_authorization.accepted",
    "completion": "stage_rules.job_start_rechecked && test_drive_completion_rule_passes && supervision_completion_rule_passes && required_invoice_and_warranty_fields_complete && no_unresolved_stop_work_or_incident_hold"
  },
  "eligibility_rule": "evaluate only stage_rules[current_event_stage]; do not require booking, assignment, customer acceptance, start, or completion facts at an earlier stage",
  "override_policy": "deny_by_default; no_override_for_legal_or_insurance_hard_gates; operational_exception_only_if_two_person_time_limited_audited"
}
