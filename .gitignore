# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
.dev.vars
.mail-catcher.jsonl

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.wrangler-staging.generated.json
/outputs/
/work/
*.tsbuildinfo

# ai council dev CLI cache (may contain question/answer text, not secrets)
/.ai-council-cache.json

# local Claude Code settings (machine-specific)
.claude/settings.local.json

# ad-build intermediates (ffmpeg work dirs and unzipped source images)
brand/ads/**/_work/
brand/ads/**/_unzip/

# Rendered ad video and its source clips. These are build output of
# brand/ads/build-got-this.ps1, not source, and ~50MB across 57 files.
# Durable copy lives in the private R2 bucket `tuveloz-brand-video`
# under the `ads/` prefix, mirroring the paths below.
brand/ads/*.mp4
brand/ads/got-this-assets/**/*.mp4
