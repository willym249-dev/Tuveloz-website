# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.wrangler-staging.generated.json
/outputs/
/work/
*.tsbuildinfo

# ai council dev CLI cache (may contain question/answer text, not secrets)
/.ai-council-cache.json

# local Claude Code settings (machine-specific)
.claude/settings.local.json

# ad-build intermediates (ffmpeg work dirs and unzipped source images)
brand/ads/**/_work/
brand/ads/**/_unzip/

# deadline checker output (regenerated on every run; see scripts/check-deadlines.mjs)
/deadline-report.md

# private business document originals — insurance, formation, licenses, tax,
# signed agreements. Track them as record cards in docs/records/ instead.
# Never commit the originals; this rule is a safety net, not permission.
/private-documents/
