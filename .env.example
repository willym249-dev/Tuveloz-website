# Cloudflare deployment credentials. Do not commit real values.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Tuveloz runtime configuration.
SITE_URL=https://your-domain.example
OWNER_EMAIL=owner@example.com
AUTH_EMAIL_HEADER=cf-access-authenticated-user-email
AUTH_CODE_SECRET=replace_with_at_least_32_random_characters

# Required for passwordless sign-in and optional provider job alerts.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Tuveloz <notifications@your-domain.example>

# Provider evidence stays quarantined until a real scanner posts a signed
# result for the exact pending scan request and file hash. Keep the provider
# unconfigured until a scanner integration is selected and tested. Store the
# webhook secret with `wrangler secret put`, never in wrangler.jsonc.
EVIDENCE_SCAN_PROVIDER=unconfigured
# Before provider onboarding approval, list both `stripe_identity` and the
# exact reviewed non-Stripe provider intended for a future manual/non-biometric
# adapter. Names and key-looking strings are configuration only. Readiness also
# requires a current guarded live Stripe completion, and the manual-alternative
# gate stays blocked until an independently verifiable allowlisted adapter is
# implemented. Owner-entered records cannot make that gate pass.
# Example only: IDENTITY_VERIFICATION_PROVIDERS=stripe_identity,approved_manual_vendor
IDENTITY_VERIFICATION_PROVIDERS=
EVIDENCE_SCAN_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# When EVIDENCE_SCAN_PROVIDER=cloudmersive, store this with
# `wrangler secret put CLOUDMERSIVE_API_KEY`; never commit the real key.
CLOUDMERSIVE_API_KEY=your_cloudmersive_api_key

# Optional: powers lib/ai-council-runtime.ts and scripts/ai-council.ts, which
# route a question to the cheapest suitable model across GPT, Gemini, and
# Claude and only call extra models when their answers disagree. Store real
# keys with `wrangler secret put` (in-app) or in a local .env.local (CLI);
# never commit real values. Any subset of the three may be set.
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe sandbox configuration. Replace these only in a private local file or
# with `wrangler secret put`; never commit real sk_*, rk_*, or whsec_* values.
STRIPE_SECRET_KEY=your_stripe_test_secret_key
STRIPE_PAYMENT_WEBHOOK_SECRET=your_stripe_payment_webhook_signing_secret
# Stripe Identity uses a separate restricted key and a dedicated standard
# snapshot webhook. This release accepts rk_test_ for flagged test providers
# only. A future reviewed live release would require rk_live_ plus both
# Identity live-mode locks; payment live mode remains separate.
STRIPE_IDENTITY_SECRET_KEY=your_stripe_identity_restricted_key
STRIPE_IDENTITY_WEBHOOK_SECRET=your_stripe_identity_webhook_signing_secret
# Create and review a reusable TEST Verification Flow in Stripe. Store its
# vf_* ID with `wrangler secret put`; do not hard-code a real account ID here.
STRIPE_IDENTITY_VERIFICATION_FLOW_ID=your_stripe_identity_verification_flow_id
# Standard snapshot destination for connected-account payout and external
# account events. It must not reuse the V2 thin destination secret below.
STRIPE_CONNECTED_ACCOUNT_WEBHOOK_SECRET=your_stripe_connected_account_snapshot_webhook_signing_secret
STRIPE_CONNECT_WEBHOOK_SECRET=your_stripe_connect_thin_webhook_signing_secret

# Leave false during sandbox development. Live payment activation must be an
# explicit decision by the legal business owner after launch review.
STRIPE_ALLOW_LIVE_MODE=false
# Identity has an independent environment lock in addition to a code lock.
# Keep this false until a reviewed release deliberately enables real-person
# Identity verification. This does not control payments or payouts.
STRIPE_IDENTITY_ALLOW_LIVE_MODE=false

# Optional SMS one-time-code sign-in for customer and provider accounts.
# Fail-closed: text sign-in stays OFF until PHONE_SMS_LIVE_MODE_ENABLED is
# flipped to true in lib/phone-auth.ts (a reviewed code change) AND all four
# secrets below are set. Phone sign-in never grants owner/admin access; owner
# access remains on the separate Cloudflare Access application. Do not enable
# production SMS until the sender/verification service, billing/rate caps,
# consent wording, privacy treatment, and abuse controls are configured and
# reviewed.
SMS_PROVIDER=your_sms_provider_identifier
SMS_API_URL=https://your-sms-provider.example/messages
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=your_verified_sms_sender_id
