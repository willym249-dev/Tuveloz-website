# Cloudflare deployment credentials. Do not commit real values.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Tuveloz runtime configuration.
SITE_URL=https://your-domain.example
OWNER_EMAIL=owner@example.com
AUTH_EMAIL_HEADER=cf-access-authenticated-user-email

# Optional provider email alerts.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Tuveloz <notifications@your-domain.example>
