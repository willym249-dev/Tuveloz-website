{
  "name": "tuveloz-launch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext deploy",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit --incremental false",
    "ai": "node --experimental-strip-types scripts/ai-council.ts",
    "ai:check": "node scripts/ai-selfcheck.mjs",
    "i18n:check": "node scripts/check-spanish-coverage.mjs",
    "readiness": "node --experimental-strip-types scripts/check-readiness.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tuveloz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tuveloz-db --remote",
    "mail:catch": "node scripts/dev-mail-catcher.mjs",
    "test:e2e": "node tests/e2e/provider-signup.e2e.mjs",
    "test:e2e:account": "node tests/e2e/account-signup.e2e.mjs",
    "test:e2e:account-form": "node tests/e2e/account-form.e2e.mjs",
    "test:e2e:customer-tools": "node tests/e2e/customer-tools.e2e.mjs",
    "test:e2e:provider-form": "node tests/e2e/provider-form.e2e.mjs",
    "test:e2e:provider-submission": "node tests/e2e/provider-submission.e2e.mjs",
    "test:e2e:public-guidance": "node tests/e2e/public-guidance.e2e.mjs",
    "test:e2e:public-forms": "node tests/e2e/public-forms.e2e.mjs",
    "test:e2e:help": "node tests/e2e/help-page.e2e.mjs",
    "test:e2e:support": "node tests/e2e/owner-support.e2e.mjs",
    "test:e2e:uploads": "node tests/e2e/provider-upload.e2e.mjs",
    "test:e2e:incident": "node tests/e2e/incident-payment-hold.e2e.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.4",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "image-size": "2.0.2",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "displayName": "Tuveloz",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
